# local reference files (may contain PII — CSVs, spreadsheets, exports)
/docs/eve-workshop/reference/*
!/docs/eve-workshop/reference/.gitkeep
!/docs/eve-workshop/reference/AI Agent-Building Workshop @ TMU - Guests - 2026-08-10-16-42-04.csv

